# Copy to .env and fill in. Never commit .env.
# API only (never put model keys in web/)
# Azure OpenAI drafts answers when both are set; no key needed (az login locally, managed identity on Azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Gemini: fallback drafter and search embeddings
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBED_MODEL=
# Comma-separated; defaults to http://localhost:3000 when empty
ALLOWED_ORIGINS=

# Web (put this one in web/.env.local)
NEXT_PUBLIC_API_URL=
